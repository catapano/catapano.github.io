<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/rhia_favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Calibri:400,700&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="wrapper">
    <header class="navbar container">
      <a id="author-name" href="/">{{ site.title }}</a>
      <ul id="navlist">
        {%- for item in site.nav %}
        <li><a href="{{ item.link }}"{% if item.newTab %} target="_blank" rel="noopener"{% endif %}>{{ item.name }}</a>{% if not loop.last %} / {% endif %}</li>
        {%- endfor %}
      </ul>
    </header>
    <main class="container content">
      <hr>
      {{ content | safe }}
      <hr>
      <footer><small>{{ site.title }}, {{ year }}</small></footer>
    </main>
  </div>
</body>
</html>
